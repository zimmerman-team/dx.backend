# Settings for running dx.backend on this machine (make dev). Copy to .env;
# `make setup` does that. In Docker, infra.dx sets these instead.

# Where the data folders (parsed-data-files/, staging/, ...) live: this repo.
DATA_EXPLORER_SSR=./

# MongoDB on this machine. Keep the empty lines: the backend needs them set,
# even to nothing, for a local MongoDB without a password.
MONGO_HOST=localhost
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=

# How much goes to stdout (DEBUG, INFO, WARNING, ERROR). logging/backend.log gets everything.
LOG_LEVEL=INFO

# From https://data.world/settings/advanced (the read/write token)
DW_AUTH_TOKEN=<YOUR_TOKEN>
